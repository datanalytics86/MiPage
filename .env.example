# Ejemplo de variables de entorno para MiPage
# Copia este archivo como .env en cada carpeta

# ===================
# FRONTEND (.env.local en frontend/)
# ===================

# API Backend (local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# API Backend (producción - cambiar cuando tengas el backend deployado)
# NEXT_PUBLIC_API_URL=https://tu-backend.railway.app/api
# NEXT_PUBLIC_SOCKET_URL=https://tu-backend.railway.app

# Supabase (opcional - para auth adicional)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Cloudinary (para uploads de imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mipage_preset

# App Config
NEXT_PUBLIC_APP_NAME=MiPage
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (opcional - para error tracking en producción)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/xxxx

# ===================
# BACKEND (.env en backend/)
# ===================

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET=tu-secreto-super-seguro-cambia-esto-en-produccion
JWT_EXPIRES_IN=7d

# Cloudinary (para almacenamiento de imágenes)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# SendGrid (para emails de invitación)
SENDGRID_API_KEY=tu-sendgrid-api-key
FROM_EMAIL=noreply@tudominio.com

# Sentry (opcional - para error tracking en producción)
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/xxxx

# Server Config
PORT=3001
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================
# INSTRUCCIONES
# ===================

# 1. FRONTEND:
#    cp .env.example frontend/.env.local
#    Editar frontend/.env.local con tus valores

# 2. BACKEND:
#    cp .env.example backend/.env
#    Editar backend/.env con tus valores

# 3. SERVICIOS GRATUITOS:
#    - Supabase: https://supabase.com (PostgreSQL gratis)
#    - Cloudinary: https://cloudinary.com (25GB gratis)
#    - SendGrid: https://sendgrid.com (100 emails/día gratis)

# 4. GENERAR JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
