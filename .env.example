# MiPage — variables de entorno (Supabase-first)
# Copia a frontend/.env.local

# ===================
# OBLIGATORIAS (frontend)
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================
# SERVIDOR (solo Vercel / local server — NO prefix NEXT_PUBLIC_)
# ===================
# SUPABASE_SERVICE_ROLE_KEY=  # seed demo + ops; nunca al browser
# RESEND_API_KEY=             # emails transaccionales (opcional)
# EMAIL_FROM=MiPage <noreply@tudominio.cl>
# MERCADOPAGO_ACCESS_TOKEN=   # featured listings (opcional)
# SENTRY_DSN=                 # observabilidad (opcional)

# ===================
# SEED DEMO
# ===================
# DEMO_SEED_PASSWORD=DemoMiPage2026!

# ===================
# E2E (Playwright) — opcionales; sin ellas los tests de auth se saltan (skip)
# ===================
# E2E_PROVIDER_EMAIL=provider@example.com
# E2E_PROVIDER_PASSWORD=...
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=...
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# ===================
# LEGACY (NO USAR)
# ===================
# El backend Express fue archivado en archive/2026-legacy/backend
# No configures NEXT_PUBLIC_API_URL ni JWT_SECRET para el producto.
