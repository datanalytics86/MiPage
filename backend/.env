# Base de datos - SQLite (para testing local)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="mipage-secret-key-development-testing-2024"
JWT_EXPIRES_IN="7d"

# Cloudinary (opcional para testing - sin uploads)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="demo"
CLOUDINARY_API_SECRET="demo"

# SendGrid (opcional - sin emails en testing)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@mipage.local"

# Configuración del servidor
PORT=3001
NODE_ENV="development"

# Frontend URL (para CORS) - Codespaces
FRONTEND_URL="https://upgraded-space-pancake-q7gvrgw947g6cwqx-3000.app.github.dev"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
