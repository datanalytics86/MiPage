// Esquema de base de datos para MiPage Marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  USER        // Usuario regular que puede dejar reseñas
  PUBLISHER   // Proveedor de servicios que puede publicar
  ADMIN       // Administrador del sitio
}

enum Category {
  MODELAJE              // Servicios de modelaje
  MASAJES_PROFESIONALES // Servicios de masajes profesionales
}

enum ServiceStatus {
  PENDING   // Pendiente de aprobación
  APPROVED  // Aprobado y visible
  REJECTED  // Rechazado por admin
  ARCHIVED  // Archivado por el publisher
}

enum ApprovalStatus {
  PENDING           // Esperando aprobación inicial
  APPROVED          // Aprobado para registrarse
  REGISTERED        // Ya completó registro
  ACTIVE            // Anuncio activo
  INACTIVE          // Anuncio desactivado
  REJECTED          // Rechazado
}

enum Contextura {
  DELGADA
  ATLETICA
  PROMEDIO
  ROBUSTA
  PLUS_SIZE
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  URL
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  DATE
  TIME
}

enum FieldCategory {
  PERSONAL        // Datos personales
  FISICA          // Características físicas
  SERVICIO        // Info del servicio
  CONTACTO        // Datos de contacto
  OTROS           // Otros
}

enum UpdateType {
  PROMOTION      // Promoción especial
  ANNOUNCEMENT   // Anuncio general
  NEWS           // Novedad
  SCHEDULE       // Cambio de horarios
}

// Modelos

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  bio           String?
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)

  // Nuevos campos para sistema de aprobación
  isActive      Boolean   @default(false)     // Activar/desactivar anuncio
  approvalStatus ApprovalStatus @default(PENDING) // Estado de aprobación
  approvedAt    DateTime?
  approvedBy    String?                       // ID del admin que aprobó
  registrationToken String? @unique           // Token para registro
  tokenExpiresAt DateTime?

  // Relaciones
  services      Service[]
  reviews       Review[]
  posts         Post[]
  favorites     Favorite[]
  notifications Notification[]
  metadata      UserMetadata?                 // Relación con metadata

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([approvalStatus])
  @@index([registrationToken])
  @@map("users")
}

model Service {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    Category
  title       String
  description String
  price       Float
  priceType   String        @default("hour") // hour, session, day
  location    String
  city        String
  region      String?

  // Fotos (array de URLs de Cloudinary)
  photos      Json          // SQLite: Json en lugar de String[]
  coverPhoto  String?       // Foto principal

  // Disponibilidad
  availability Json?        // { days: [], hours: [] }

  // Status y moderación
  status      ServiceStatus @default(PENDING)
  views       Int           @default(0)
  isPremium   Boolean       @default(false)

  // Nuevos campos para promociones y estadísticas
  viewCount   Int      @default(0)           // Contador de vistas
  isPromoted  Boolean  @default(false)       // En promoción
  promotedUntil DateTime?                    // Hasta cuando está en promoción

  // Relaciones
  reviews     Review[]
  favorites   Favorite[]
  updates     ServiceUpdate[]                // Nueva relación con actualizaciones

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([city])
  @@map("services")
}

model Review {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating    Int      // 1-5
  comment   String
  photos    Json     // SQLite: Json en lugar de String[]

  // Respuesta del publisher
  response  String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, userId]) // Un usuario solo puede dejar una reseña por servicio
  @@index([serviceId])
  @@index([userId])
  @@map("reviews")
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String
  photos    Json     // SQLite: Json en lugar de String[]
  type      String   @default("update") // update, promotion, announcement

  likes     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@index([userId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  type      String   // review, favorite, service_approved, etc.
  link      String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ==========================================
// NUEVOS MODELOS - SISTEMA DE METADATA
// ==========================================

model UserMetadata {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // DATOS PERSONALES FIJOS (optimizados para búsqueda)
  rut           String?
  edad          Int?
  nacionalidad  String?

  // DATOS FÍSICOS FIJOS
  altura        Int?                          // en cm
  peso          Int?                          // en kg
  contextura    Contextura?
  medidas       String?                       // Ej: "90-60-90"

  // UBICACIÓN FIJA
  region        String?
  ciudad        String?
  comuna        String?
  direccion     String?

  // SERVICIO
  tipoServicio  Category?

  // OTROS
  biografia     String?
  horarios      String?                       // JSON string con horarios
  tarifas       String?                       // Detalles de precios

  // Relación con campos custom
  customValues  CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([rut])
  @@index([ciudad])
  @@index([tipoServicio])
  @@index([contextura])
  @@map("user_metadata")
}

model MetadataField {
  id          String   @id @default(uuid())
  fieldName   String   @unique              // ej: "colorOjos" (sin espacios, camelCase)
  fieldLabel  String                        // ej: "Color de Ojos"
  fieldType   FieldType                     // Tipo de campo
  category    FieldCategory                 // Categoría para agrupar

  required    Boolean  @default(false)
  placeholder String?
  helpText    String?

  // Para campos tipo SELECT o MULTISELECT
  options     Json?                         // ["Azul", "Verde", "Café", "Negro"]

  // Para validación
  minLength   Int?
  maxLength   Int?
  minValue    Int?
  maxValue    Int?
  pattern     String?                       // Regex para validación

  // UI
  order       Int      @default(0)          // Orden de aparición en formulario
  isActive    Boolean  @default(true)       // Mostrar/ocultar campo
  showInTable Boolean  @default(true)       // Mostrar en tabla admin

  // Relaciones
  values      CustomFieldValue[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fieldName])
  @@index([category])
  @@index([order])
  @@map("metadata_fields")
}

model CustomFieldValue {
  id          String   @id @default(uuid())

  metadataId  String
  metadata    UserMetadata @relation(fields: [metadataId], references: [id], onDelete: Cascade)

  fieldId     String
  field       MetadataField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value       String                         // Valor como string (parsear según fieldType)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([metadataId, fieldId])           // Un usuario, un valor por campo
  @@index([metadataId])
  @@index([fieldId])
  @@map("custom_field_values")
}

model ServiceUpdate {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  type        UpdateType
  title       String?
  content     String
  imageUrl    String?

  isActive    Boolean  @default(true)
  isPinned    Boolean  @default(false)       // Fijar arriba en timeline

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([type])
  @@index([createdAt])
  @@map("service_updates")
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique              // "MASAJES", "MODELAJE", etc
  label       String                        // "Masajes Profesionales"
  description String?
  icon        String?                       // Emoji o nombre de icono
  color       String?                       // Color hex para UI
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([order])
  @@map("service_types")
}
