# Supabase (required for real auth/data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=MiPage <noreply@yourdomain.cl>
# MERCADOPAGO_ACCESS_TOKEN=
# SENTRY_DSN=

# Demo seed (npm run seed:demo)
# DEMO_SEED_PASSWORD=DemoMiPage2026!

# E2E Playwright (optional — without these, auth flows are skipped cleanly)
# E2E_PROVIDER_EMAIL=provider@example.com
# E2E_PROVIDER_PASSWORD=
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
